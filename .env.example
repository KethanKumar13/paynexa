# Optional overrides for docker compose; every value below is already the default.
POSTGRES_USER=paynexa
POSTGRES_PASSWORD=paynexa
POSTGRES_DB=paynexa
DB_HOST_PORT=5544
API_HOST_PORT=8088
PSP_HOST_PORT=8089
PSP_LATENCY_MS=100
PSP_TIMEOUT_TOKEN_MS=30000
RUST_LOG=info,tower_http=info
# DEV ONLY demo key, seeded on startup. Leave unset outside local development.
DEV_API_KEY=pnx_live_devkey01_DEVONLY_local_demo_key_not_a_secret

# API -> PSP calls and the reconciliation sweeper.
PSP_CONNECT_TIMEOUT_MS=2000
PSP_TIMEOUT_MS=5000
SWEEPER_INTERVAL_MS=10000
SWEEPER_MIN_AGE_MS=15000
SWEEPER_ALERT_AGE_MS=600000
PSP_NOT_FOUND_GRACE_MS=60000

# Webhook delivery. WEBHOOK_LEASE_MS must be greater than WEBHOOK_TIMEOUT_MS.
WEBHOOK_POLL_INTERVAL_MS=1000
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_LEASE_MS=30000
# Delays before each retry (ms). Demo tip: 2000,2000 gives up on a failing receiver in ~4 s.
WEBHOOK_RETRY_SCHEDULE_MS=60000,300000,900000,3600000,21600000
